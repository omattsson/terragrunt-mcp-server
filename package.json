{
  "name": "terragrunt-mcp-server",
  "version": "1.0.1",
  "description": "MCP Server for Terragrunt integration with comprehensive documentation support",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:core": "node bin/terragrunt-mcp-core",
    "start:config": "node bin/terragrunt-mcp-config",
    "start:guidance": "node bin/terragrunt-mcp-guidance",
    "start:observability": "node bin/terragrunt-mcp-observability",
    "measure-tokens": "tsx scripts/measure-token-overhead.ts",
    "benchmark-modes": "tsx scripts/benchmark-modes.ts",
    "verify-modes": "tsx scripts/verify-mode-loading.ts",
    "measure-memory": "node --expose-gc --loader tsx scripts/measure-memory.ts",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "npm run test:unit && npm run test:integration:vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:fast": "vitest run --config vitest.unit.config.ts --no-coverage --pool=forks",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "node test/server-test.js",
    "test:integration:vitest": "vitest run --config vitest.integration.config.ts",
    "test:integration:cache": "node test/integration/cache-persistence.test.js",
    "test:integration:errors": "node test/integration/error-handling.test.js",
    "test:integration:functions": "node test/integration/functions-tools.test.js",
    "test:integration:all": "npm run test:integration:vitest && node test/server-test.js && node test/integration/functions-tools.test.js",
    "test:server": "node test/server-test.js",
    "test:all": "npm run test:unit && npm run test:integration:all",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check-schema-drift": "tsx scripts/check-schema-drift.ts",
    "docker:build": "docker build -t terragrunt-mcp-server:latest .",
    "docker:run": "docker run -i terragrunt-mcp-server:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "@types/mustache": "^4.2.6",
    "cheerio": "^1.0.0-rc.12",
    "lru-cache": "^11.2.2",
    "mustache": "^4.2.0",
    "node-fetch": "^3.3.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.3",
    "@vitest/ui": "^4.0.3",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.3"
  },
  "type": "module",
  "bin": {
    "terragrunt-mcp-server": "./dist/index.js",
    "terragrunt-mcp-core": "./bin/terragrunt-mcp-core",
    "terragrunt-mcp-config": "./bin/terragrunt-mcp-config",
    "terragrunt-mcp-guidance": "./bin/terragrunt-mcp-guidance",
    "terragrunt-mcp-observability": "./bin/terragrunt-mcp-observability"
  },
  "keywords": [
    "terragrunt",
    "mcp",
    "server",
    "typescript"
  ],
  "author": "Olof Mattsson",
  "maintainers": [
    "omattsson"
  ],
  "license": "MIT"
}
